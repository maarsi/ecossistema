# Lista de PERMISSAO: a pasta é alvo de sincronizacao (Syncthing), entao tudo e ignorado
# por padrao e apenas o que e do ecossistema entra no git.
/*
!/bin/
!/bench/
!/config/
!/mcp/
!/CLAUDE.md
!/instrucoes_claude.txt
!/README.md
!/.gitignore
!/.stignore
# exclusoes dentro do que foi permitido
bench/imagens/
bench/dados/
cache/
__pycache__/
*.log
*.tmp
.env

# bateria DER-PR: material de trabalho, nao e codigo nem registro
bench/derpr/cuda128/
bench/derpr/fonte_ocr/
bench/derpr/paginas/
bench/derpr/textos/
bench/derpr/prevoo/paginas/
bench/derpr/*.pdf
bench/derpr/prevoo/*.pdf
bench/derpr/prevoo/saidas/
bench/derpr/prevoo/camada_texto.json
